{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "impressPlayer",
  "version": "0.9.1",
  "identifier": "sk.panakrala.impressPlayer",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npx vite --config vite.config.mjs",
    "beforeBuildCommand": "npx vite build --config vite.config.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' asset: https://asset.localhost; img-src 'self' asset: https://asset.localhost data: blob:; font-src 'self' asset: https://asset.localhost data:; media-src 'self' asset: https://asset.localhost blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; frame-src 'self' blob: https: http:;",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["**"]
        }
      }
    },
    "windows": [
      {
        "label": "controller",
        "title": "impressPlayer Controller",
        "width": 1200,
        "height": 800,
        "url": "controller.html",
        "center": true,
        "devtools": true,
        "backgroundColor": "#13132A"
      },
      {
        "label": "projector",
        "title": "impressPlayer Projector",
        "width": 1920,
        "height": 1080,
        "url": "projector.html",
        "visible": false,
        "backgroundColor": "#13132A"
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "linux": {
      "appimage": {},
      "deb": {}
    },
    "windows": {
      "nsis": {}
    }
  }
}
